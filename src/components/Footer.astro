---
import type { Locale } from '../i18n/types';
import type { Translations } from '../i18n/types';
import { localizedPath } from '../i18n/utils';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
const currentYear = new Date().getFullYear();
const servicesHref = localizedPath('/#servicii', locale);
---

<footer class="border-t border-white/10 bg-ink text-white">
  <div class="section-padding pb-10 pt-16">
    <div class="container-narrow">
      <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3">
        <div>
          <Logo variant="light" locale={locale} homeLabel={t.header.homeAria} />
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">
            {t.footer.tagline}
          </p>
        </div>

        <div>
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-white/40">
            {t.footer.services}
          </h3>
          <ul class="space-y-2.5">
            {
              t.footer.serviceLinks.map((label) => (
                <li>
                  <a
                    href={servicesHref}
                    class="text-sm text-white/70 transition-colors hover:text-white"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-white/40">
            {t.footer.contact}
          </h3>
          <ul class="space-y-2.5 text-sm text-white/70">
            <li>
              <a href="mailto:contact@softmasters.ro" class="transition-colors hover:text-white">
                contact@softmasters.ro
              </a>
            </li>
            <li>
              <a href={localizedPath('/contact', locale)} class="transition-colors hover:text-white">
                {t.footer.contactForm}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
        <p class="text-sm text-white/40">
          &copy; {currentYear} Soft Masters. {t.footer.rights}
        </p>
        <p class="text-sm text-white/40">
          {t.footer.keywords}
        </p>
      </div>
    </div>
  </div>
</footer>
