---
interface Props {
  label?: string;
  title: string;
  description?: string;
  light?: boolean;
  align?: 'left' | 'center';
}

const {
  label,
  title,
  description,
  light = false,
  align = 'center',
} = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
const maxWidth = align === 'center' ? 'max-w-3xl' : 'max-w-2xl';
---

<div class:list={[alignClass, maxWidth, 'mb-12 lg:mb-16']}>
  {
    label && (
      <p
        class:list={[
          'mb-3 text-sm font-semibold uppercase tracking-widest',
          light ? 'text-brand-light' : 'text-brand',
        ]}
      >
        {label}
      </p>
    )
  }
  <h2
    class:list={[
      'text-3xl font-bold tracking-tight sm:text-4xl lg:text-[2.75rem] lg:leading-tight',
      light ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {
    description && (
      <p
        class:list={[
          'mt-4 text-lg leading-relaxed',
          light ? 'text-white/70' : 'text-ink-muted',
        ]}
      >
        {description}
      </p>
    )
  }
</div>
