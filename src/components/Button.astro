---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'outline-light';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium transition-all duration-200 rounded-xl';

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const variants = {
  primary:
    'bg-brand text-white hover:bg-brand-dark shadow-sm hover:shadow-md',
  secondary:
    'bg-ink text-white hover:bg-ink/90',
  outline:
    'border border-surface-border bg-white text-ink hover:border-ink/30 hover:bg-surface-muted',
  'outline-light':
    'border border-white/25 bg-white/5 text-white hover:bg-white/10 hover:border-white/40',
};
---

<a href={href} class:list={[base, sizes[size], variants[variant], className]}>
  <slot />
</a>
