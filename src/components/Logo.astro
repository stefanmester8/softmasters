---
import type { Locale } from '../i18n/types';
import { localizedPath } from '../i18n/utils';

interface Props {
  variant?: 'light' | 'dark';
  locale?: Locale;
  homeLabel?: string;
  class?: string;
}

const {
  variant = 'dark',
  locale = 'ro',
  homeLabel = 'Soft Masters - Home',
  class: className = '',
} = Astro.props;

const iconSrc =
  variant === 'light'
    ? '/images/logo/icon-light.png'
    : '/images/logo/icon-dark.png';

const wordmarkSrc =
  variant === 'light'
    ? '/images/logo/wordmark-light.png'
    : '/images/logo/wordmark-dark.png';

const homeHref = localizedPath('/', locale);
---

<a
  href={homeHref}
  class:list={['inline-flex items-center gap-2.5 sm:gap-3 group', className]}
  aria-label={homeLabel}
>
  <img
    src={iconSrc}
    alt=""
    width="36"
    height="36"
    class="h-8 w-8 shrink-0 object-contain transition-transform duration-300 group-hover:scale-105 sm:h-9 sm:w-9"
    loading="eager"
    decoding="async"
  />
  <img
    src={wordmarkSrc}
    alt="Soft Masters"
    width="160"
    height="36"
    class="h-7 w-auto object-contain sm:h-8"
    loading="eager"
    decoding="async"
  />
</a>
