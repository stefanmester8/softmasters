---
import type { Locale } from '../../i18n/types';
import type { Translations } from '../../i18n/types';
import { localizedPath } from '../../i18n/utils';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';

interface Props {
  t: Translations;
  locale: Locale;
}

const { t, locale } = Astro.props;
const s = t.pricing;
---

<section id="preturi" class="section-padding bg-surface-muted">
  <div class="container-narrow">
    <SectionHeading label={s.label} title={s.title} description={s.description} />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.packages.map((pkg) => (
          <article
            class:list={[
              'flex flex-col rounded-2xl border p-6 transition-shadow duration-300',
              pkg.featured
                ? 'border-brand bg-white shadow-card-hover ring-1 ring-brand/20'
                : 'border-surface-border bg-white shadow-card hover:shadow-card-hover',
            ]}
          >
            {pkg.featured && (
              <span class="mb-3 inline-block w-fit rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand">
                {s.popular}
              </span>
            )}
            <h3 class="text-lg font-semibold text-ink">{pkg.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">{pkg.description}</p>
            <p class="mt-6 text-2xl font-bold text-ink">{pkg.price}</p>
            <div class="mt-4">
              <Button
                href={localizedPath('/contact', locale)}
                variant={pkg.featured ? 'primary' : 'outline'}
                class="w-full text-center"
              >
                {s.requestQuote}
              </Button>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-ink-subtle">{s.note}</p>
  </div>
</section>
