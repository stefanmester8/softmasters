---
import type { Translations } from '../../i18n/types';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const s = t.whatWeBuild;
---

<section id="ce-construim" class="section-padding bg-white">
  <div class="container-narrow">
    <SectionHeading label={s.label} title={s.title} description={s.description} />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.audiences.map((item) => (
          <article class="card group">
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand transition-colors group-hover:bg-brand group-hover:text-white">
              {item.icon === 'building' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5M3.75 21V5.25A2.25 2.25 0 016 3.75h12A2.25 2.25 0 0120.25 5.25V21M9 9h.008v.008H9V9zm0 3h.008v.008H9V12zm0 3h.008v.008H9V15zm3-6h.008v.008H12V9zm0 3h.008v.008H12V12zm0 3h.008v.008H12V15zm3-6h.008v.008H15V9zm0 3h.008v.008H15V12zm0 3h.008v.008H15V15z" />
                </svg>
              )}
              {item.icon === 'rocket' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.58-5.84a14.98 14.98 0 012.12 6.16M18 12a6 6 0 11-12 0 6 6 0 0112 0z" />
                </svg>
              )}
              {item.icon === 'lightbulb' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-3.465 0c.85.493 1.508 1.333 1.508 2.316V18" />
                </svg>
              )}
              {item.icon === 'user' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
              )}
              {item.icon === 'store' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 0V21" />
                </svg>
              )}
              {item.icon === 'team' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.09 9.09 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-2.167 3 3 0 00-4.681-2.72m-12 0A5.971 5.971 0 014.06 16.5m0 0A11.953 11.953 0 0112 10.5c2.998 0 5.74 1.1 7.834 2.933M4.06 16.5A11.953 11.953 0 0012 21m8.94-4.5a5.971 5.971 0 00-.94-2.167m0 0A11.945 11.945 0 0112 12c-2.998 0-5.74-1.1-7.834-2.933" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
