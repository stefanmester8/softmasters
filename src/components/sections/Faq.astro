---
import SectionHeading from '../SectionHeading.astro';

const faqs = [
  {
    q: 'Pot construi doar un site simplu?',
    a: 'Da. Realizam site-uri de prezentare profesionale, de la o pagina simpla la site-uri complete cu mai multe sectiuni, formulare si optimizare SEO.',
  },
  {
    q: 'Pot transforma o idee intr-un MVP?',
    a: 'Absolut. Lucram cu antreprenori si persoane fizice care au o idee si vor o prima versiune functionala pentru testare sau prezentare investitorilor.',
  },
  {
    q: 'Putem lucra si cu persoane fizice, nu doar firme?',
    a: 'Da. Colaboram cu firme, startup-uri si persoane fizice. Nu ai nevoie de o companie inregistrata pentru a incepe un proiect cu noi.',
  },
  {
    q: 'Faceti si aplicatii mobile?',
    a: 'Da. Construim aplicatii mobile pentru Android si iOS, atat pentru clienti finali cat si pentru uz intern.',
  },
  {
    q: 'Puteti automatiza procese existente?',
    a: 'Da. Analizam fluxurile tale actuale si construim automatizari care elimina munca repetitiva — de la formulare la integrari intre sisteme.',
  },
  {
    q: 'Puteti integra AI sau OCR?',
    a: 'Da. Integrarea serviciilor AI si OCR face parte din gama noastra de servicii, alaturi de aplicatii web, mobile si platforme SaaS.',
  },
  {
    q: 'Cat dureaza un proiect?',
    a: 'Depinde de complexitate. Un site de prezentare poate fi gata in cateva saptamani, iar un MVP sau o aplicatie custom poate dura 1-3 luni. Stabilim un termen clar la inceput.',
  },
  {
    q: 'Pot incepe cu o versiune mica si sa extind ulterior?',
    a: 'Da, si chiar recomandam asta. Construim arhitectura astfel incat sa poti adauga functionalitati pe masura ce produsul creste.',
  },
];
---

<section id="faq" class="section-padding bg-white">
  <div class="container-narrow">
    <SectionHeading
      label="FAQ"
      title="Intrebari frecvente"
      description="Raspunsuri la cele mai comune intrebari despre cum lucram."
    />

    <div class="mx-auto max-w-3xl divide-y divide-surface-border">
      {
        faqs.map((faq) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-ink">
              {faq.q}
              <svg
                class="h-5 w-5 shrink-0 text-ink-subtle transition-transform group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <p class="mt-3 pr-8 text-sm leading-relaxed text-ink-muted">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
