---
import SectionHeading from '../SectionHeading.astro';

const features = [
  'Tabel clienti si lucrari',
  'Status pe fiecare caz',
  'Upload documente',
  'Completare automata documente',
  'Scanare si extragere date',
  'Arhiva digitala',
  'Dashboard intern',
];
---

<section id="proiecte" class="section-padding bg-white">
  <div class="container-narrow">
    <SectionHeading
      label="Exemplu de proiect"
      title="Exemplu: platforma digitala pentru gestionarea dosarelor si documentelor"
      description="Un exemplu concret de tip de proiect pe care il putem realiza. Nu este singurul nostru focus — construim orice tip de produs digital, de la site-uri la SaaS."
    />

    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="space-y-4">
        {
          features.map((feature) => (
            <div class="flex items-center gap-3">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand/10">
                <svg class="h-4 w-4 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <span class="text-ink">{feature}</span>
            </div>
          ))
        }
      </div>

      <div class="relative" aria-hidden="true">
        <div class="rounded-2xl border border-surface-border bg-surface-muted p-6">
          <div class="mb-4 flex items-center justify-between">
            <span class="text-sm font-semibold text-ink">Dosare active</span>
            <span class="rounded-full bg-brand/10 px-3 py-1 text-xs font-medium text-brand">Exemplu UI</span>
          </div>
          <div class="space-y-2">
            {
              [
                { client: 'Client A', status: 'In lucru', color: 'bg-amber-100 text-amber-700' },
                { client: 'Client B', status: 'Finalizat', color: 'bg-green-100 text-green-700' },
                { client: 'Client C', status: 'Documente', color: 'bg-blue-100 text-blue-700' },
                { client: 'Client D', status: 'Review', color: 'bg-purple-100 text-purple-700' },
              ].map((row) => (
                <div class="flex items-center justify-between rounded-lg border border-surface-border bg-white px-4 py-3">
                  <span class="text-sm font-medium text-ink">{row.client}</span>
                  <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', row.color]}>
                    {row.status}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <p class="mt-4 text-center text-sm text-ink-subtle">
          Acesta este doar un exemplu — fiecare proiect este construit pe masura.
        </p>
      </div>
    </div>
  </div>
</section>
