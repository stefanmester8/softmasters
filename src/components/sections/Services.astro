---
import type { Translations } from '../../i18n/types';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const s = t.services;
---

<section id="servicii" class="section-padding bg-ink text-white">
  <div class="container-narrow">
    <SectionHeading label={s.label} title={s.title} description={s.description} light={true} />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.items.map((service) => (
          <article class="card-dark">
            <div class="mb-3 h-1 w-8 rounded-full bg-brand"></div>
            <h3 class="text-base font-semibold text-white">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{service.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
