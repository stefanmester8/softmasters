---
import SectionHeading from '../SectionHeading.astro';

const techGroups = [
  {
    label: 'Frontend',
    items: ['Angular', 'React', 'Next.js', 'Astro'],
  },
  {
    label: 'Backend',
    items: ['Node.js', 'NestJS'],
  },
  {
    label: 'Baze de date',
    items: ['PostgreSQL', 'MongoDB'],
  },
  {
    label: 'Infrastructura',
    items: ['Docker', 'AWS'],
  },
  {
    label: 'Integrari',
    items: ['API integrations', 'AI / OCR services'],
  },
];
---

<section id="tehnologii" class="section-padding bg-ink text-white">
  <div class="container-narrow">
    <SectionHeading
      label="Tehnologii"
      title="Stack-ul potrivit pentru fiecare proiect"
      description="Alegem tehnologiile in functie de cerintele proiectului — nu impunem un singur stack pentru tot."
      light={true}
    />

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        techGroups.map((group) => (
          <div>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-white/40">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                group.items.map((tech) => (
                  <span class="rounded-lg border border-white/10 bg-white/5 px-3.5 py-2 text-sm font-medium text-white/80">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
