---
import type { Translations } from '../../i18n/types';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const s = t.technologies;
---

<section id="tehnologii" class="section-padding bg-ink text-white">
  <div class="container-narrow">
    <SectionHeading label={s.label} title={s.title} description={s.description} light={true} />

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.groups.map((group) => (
          <div>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-widest text-white/40">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                group.items.map((tech) => (
                  <span class="rounded-lg border border-white/10 bg-white/5 px-3.5 py-2 text-sm font-medium text-white/80">
                    {tech}
                  </span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
