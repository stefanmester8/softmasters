---
import type { Translations } from '../../i18n/types';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const s = t.saasMvp;
---

<section class="section-padding bg-ink text-white">
  <div class="container-narrow">
    <SectionHeading label={s.label} title={s.title} description={s.description} light={true} />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.items.map((item) => (
          <article class="card-dark">
            <h3 class="text-base font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
