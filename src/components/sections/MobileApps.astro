---
import type { Translations } from '../../i18n/types';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const s = t.mobile;
---

<section class="section-padding bg-surface-muted">
  <div class="container-narrow">
    <SectionHeading label={s.label} title={s.title} description={s.description} />

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="space-y-4">
        {
          s.points.map((point) => (
            <article class="card">
              <h3 class="font-semibold text-ink">{point.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{point.description}</p>
            </article>
          ))
        }
      </div>

      <div class="flex items-center justify-center" aria-hidden="true">
        <div class="relative w-full max-w-xs">
          <div class="mx-auto rounded-[2.5rem] border-4 border-ink/10 bg-white p-3 shadow-card">
            <div class="overflow-hidden rounded-[2rem] bg-surface-muted">
              <div class="bg-brand px-4 py-6 text-center text-white">
                <img
                  src="/images/logo/icon-brand.png"
                  alt=""
                  width="48"
                  height="48"
                  class="mx-auto mb-3 h-12 w-12 object-contain"
                />
                <p class="text-sm font-semibold">{s.appTitle}</p>
                <p class="mt-1 text-xs text-white/70">{s.appSubtitle}</p>
              </div>
              <div class="space-y-2 p-4">
                <div class="h-10 rounded-lg border border-surface-border bg-white"></div>
                <div class="h-10 rounded-lg border border-surface-border bg-white"></div>
                <div class="h-10 rounded-lg border border-brand/20 bg-brand/10"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
