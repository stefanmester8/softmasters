---
import Logo from './Logo.astro';

const navItems = [
  { label: 'Servicii', href: '/#servicii' },
  { label: 'Proiecte', href: '/#proiecte' },
  { label: 'Proces', href: '/#proces' },
  { label: 'Tehnologii', href: '/#tehnologii' },
  { label: 'Contact', href: '/contact' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-surface-border/60 bg-white/80 backdrop-blur-lg"
>
  <div class="container-narrow flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navigare principala">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-xl bg-brand px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-brand-dark"
      >
        Discuta proiectul tau
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-lg p-2 text-ink md:hidden"
      aria-label="Deschide meniul"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-surface-border bg-white md:hidden"
    role="dialog"
    aria-label="Meniul mobil"
  >
    <nav class="container-narrow flex flex-col gap-1 px-4 py-4" aria-label="Navigare mobila">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="mt-2 rounded-xl bg-brand px-4 py-3 text-center text-sm font-medium text-white"
      >
        Discuta proiectul tau
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
