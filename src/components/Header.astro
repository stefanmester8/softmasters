---
import type { Locale } from '../i18n/types';
import type { Translations } from '../i18n/types';
import { localizedPath } from '../i18n/utils';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;

const navItems = [
  { label: t.nav.services, href: localizedPath('/#servicii', locale) },
  { label: t.nav.projects, href: localizedPath('/#proiecte', locale) },
  { label: t.nav.process, href: localizedPath('/#proces', locale) },
  { label: t.nav.technologies, href: localizedPath('/#tehnologii', locale) },
  { label: t.nav.contact, href: localizedPath('/contact', locale) },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-surface-border bg-white">
  <div class="container-narrow flex h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <Logo locale={locale} homeLabel={t.header.homeAria} />

    <nav class="hidden items-center gap-8 md:flex" aria-label={t.header.mainNav}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <LanguageSwitcher locale={locale} />
      <a
        href={localizedPath('/contact', locale)}
        class="inline-flex items-center justify-center rounded-xl bg-brand px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-brand-dark"
      >
        {t.nav.cta}
      </a>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <LanguageSwitcher locale={locale} />
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg p-2 text-ink"
        aria-label={t.header.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-surface-border bg-white md:hidden"
    role="dialog"
    aria-label={t.header.mobileNav}
  >
    <nav class="container-narrow flex flex-col gap-1 px-4 py-4" aria-label={t.header.mobileNav}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={localizedPath('/contact', locale)}
        class="mt-2 rounded-xl bg-brand px-4 py-3 text-center text-sm font-medium text-white"
      >
        {t.nav.cta}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
